; Engine configuration file.
; Edit through Godot where practical to preserve valid setting names.

config_version=5

[application]

config/name="Cannon Golf Prototype"
config/description="A retry-driven 3D cannon golf physics puzzle."
run/main_scene="res://scenes/cannon_golf/cannon_golf.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/ui/paint_mountain_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.en.translation", "res://translations/ui.ko.translation")

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="projectile"
3d_physics/layer_3="mechanism"
3d_physics/layer_4="selection"

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.72, 0.82, 0.9, 1)
