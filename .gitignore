# Godot-generated state
.godot/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local builds and transient validation output
builds/
/reports/
*.log

# Delivery screenshots are evidence, not runtime texture assets.
screenshots/*.png.import
# Documentation images are evidence or design inputs, never runtime textures.
docs/**/*.import
project-specs/**/*.import
resources/generated_stage_catalogs/.*.staging/

# Local course-generation experiments are not runtime inputs.
resources/cannon_golf/prepared.failed/
resources/cannon_golf/prepared.failed2/
resources/cannon_golf/prepared.next/
resources/cannon_golf/prepared.preview/
resources/cannon_golf/prepared.rollback/
tests/tmp_*.gd*
